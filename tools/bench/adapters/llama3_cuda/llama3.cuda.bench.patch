+            ",\"batch\":1,\"context_len\":%d,\"total_positions\":%d,\"decode_steps\":%d,\"sampling\":\"greedy\"}",
+            args->context_len, args->max_new_tokens, run->n_decode);
+    fputs(",\"precision\":{\"weights\":\"fp32\",\"activations\":\"fp32\",\"kv\":\"fp32\",\"tf32\":false}", stdout);
